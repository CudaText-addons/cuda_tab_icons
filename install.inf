[info]
title=Tab Icons
desc=1) Shows file-type icons on ui-tabs, detected from lexer; 2) allows to set user-chosen ui-tab icons for named documents.
type=cudatext-plugin
subdir=cuda_tab_icons
homepage=https://github.com/CudaText-addons/cuda_tab_icons

[item1]
section=events
events=on_lexer,on_open,on_state_ed~

[item2]
section=commands
caption=Tab Icons\Set document's tab icon...
method=iconify_current

[item3]
section=commands
caption=Tab Icons\Reset document's tab icon
method=clear_current


[item10]
section=commands
caption=Tab Icons\Config
method=config
menu=o
